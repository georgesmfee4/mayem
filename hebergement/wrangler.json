{
  "name": "mayem-api",
  "main": "worker.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "assets": {
    "directory": "../api",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": [
      "/*",
      "!/",
      "!/index.html","!/confidentialite","!/confidentialite.html","!/demo","!/demo.html",
      "!/v1/index.json",
      "!/v1/langues.json",
      "!/v1/cles-publiques.json",
      "!/v1/schema.json",
      "!/v1/openapi.json",
      "!/v1/langues/*",
      "!/v1/packs/*",
      "!/v1/script/*",
      "!/v1/outils/*"
    ]
  },
  "kv_namespaces": [{ "binding": "CLES_ACCES", "id": "fe08dd795a15406ca5f275252847405c" }]
}
