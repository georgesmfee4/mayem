{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pack de langue Mayem",
  "type": "object",
  "required": ["langue", "nom", "version", "date", "empreinte", "orthographe", "etiquettes", "glossaire", "phrases"],
  "properties": {
    "langue": { "type": "string", "description": "Code ISO 639-3, par exemple bum pour le bulu" },
    "nom": { "type": "string" },
    "version": { "type": "string", "description": "Version sémantique : correction -> 0.0.x, phrase ou terme ajouté ou retiré -> 0.x.0" },
    "date": { "type": "string", "description": "Date de la version, AAAA-MM-JJ" },
    "empreinte": { "type": "string", "description": "sha256- suivi du SHA-256 du pack sérialisé sans ce champ (core/empreinte.ts)" },
    "producteur": { "type": "string", "description": "Titulaire des droits sur les données (Équipe Mayem)" },
    "droits": { "type": "string", "description": "Conditions d'utilisation : tous droits réservés, voir la documentation de l'API" },
    "orthographe": { "type": "string" },
    "etiquettes": {
      "type": "object",
      "description": "Catégorie d'un message inédit -> id de la phrase qui sert d'étiquette",
      "properties": {
        "securite": { "type": "string" },
        "erreur": { "type": "string" },
        "frais": { "type": "string" },
        "info": { "type": "string" }
      }
    },
    "glossaire": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "terme", "sens", "en", "bulu", "critique", "a_eviter", "traduit_par", "relu_par", "commentaire"],
        "properties": {
          "ref": { "type": "string" },
          "terme": { "type": "string" },
          "sens": { "type": "string" },
          "en": { "type": "string" },
          "bulu": { "type": "string" },
          "critique": { "type": "boolean" },
          "a_eviter": { "type": "string" },
          "traduit_par": { "type": "string" },
          "relu_par": { "type": "string" },
          "commentaire": { "type": "string" }
        }
      }
    },
    "phrases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "fr", "en", "bulu", "critique", "traduit_par", "relu_par", "retraduit_par", "retraduction", "valide"],
        "properties": {
          "id": { "type": "string" },
          "fr": { "type": "string" },
          "en": { "type": "array", "items": { "type": "string" } },
          "bulu": { "type": "string" },
          "critique": { "type": "boolean" },
          "traduit_par": { "type": "string" },
          "relu_par": { "type": "string" },
          "retraduit_par": { "type": "string", "description": "Personne qui a retraduit le bulu en français sans voir l'original" },
          "retraduction": { "type": "string", "description": "Sa retraduction, à comparer au français" },
          "valide": { "type": "boolean" }
        }
      }
    }
  }
}
