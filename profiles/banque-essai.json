    "operations": [
      { "chemin": "transfert", "intention": "transfert", "statut": "en_attente_confirmation" },
      { "chemin": "transfert/confirmer", "intention": "transfert", "statut": "executee" }
    ]
  },
  "ussd": {
    "service": "http://127.0.0.1:8788/ussd",
    "code": "*123#",
    "succes": "^Opération réussie",
    "raccourcis": {
      "solde": ["1"],
      "historique": ["3"],
      "transfert": ["2", "{telephone}", "{montant}"],
      "credit": ["4", "{telephone}", "{montant}"]
    }
  }
}
