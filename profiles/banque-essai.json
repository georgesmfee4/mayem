{
  "_lisez_moi": "Profil de la banque d'essai (fixtures/services/banque.js). Un profil dit où se trouve le service existant et comment ses menus se parcourent : brancher un nouveau service, c'est écrire ce fichier, pas du code.",
  "nom": "Banque d'essai",
  "langue": "bum",
  "api": {
    "base": "http://127.0.0.1:8788/api",
    "client": "x-client-telephone",
